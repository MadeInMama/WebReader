@using WebReader.Models
@using WebReader.Models.Ui
@using TaskStatus = WebReader.Models.TaskStatus
@model WebReader.Models.Dtos.AllScheduledTaskConfigsViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
    ViewData["Title"] = "Scheduled Tasks";

    List<MultiSelectOption> typeOptions =
    [
        .. GetS3Types().OrderBy(f => f).Select(x => new MultiSelectOption { Group = "S3", Value = ((int)x).ToString(), Text = $"{x}({(int)x})" }),
        .. GetDownloadTypes().OrderBy(f => f).Select(x => new MultiSelectOption { Group = "Download", Value = ((int)x).ToString(), Text = $"{x}({(int)x})" }),
        .. GetDeleteTypes().OrderBy(f => f).Select(x => new MultiSelectOption { Group = "Delete", Value = ((int)x).ToString(), Text = $"{x}({(int)x})" }),
        .. GetOtherTypes().OrderBy(f => f).Select(x => new MultiSelectOption { Group = "Other", Value = ((int)x).ToString(), Text = $"{x}({(int)x})" })
    ];
}

@section Style
{
    <link rel="stylesheet" href="~/css/scheduled-tasks.css" asp-append-version="true"/>
}

@section SpecialInfo
{
    @if (User.Identity is { IsAuthenticated: true })
    {
        <h3 class="special-info-big">Hello, @User.Identity.Name!</h3>
    }
}

@await Html.PartialAsync("_ModalInfoWithCustomHtml")

<div class="tools">
    <form id="create-task">
        <h3>Create new task</h3>

        <div class="create-task-types-container">
            <label for="create-task-types">Type:</label>
            <select id="create-task-types" class="click-effect" required>
                <optgroup label="S3">
                    @foreach (var item in Model.Items.Where(f => GetS3Types().Contains(f.Type)).OrderBy(f => f.Type).ToList())
                    {
                        <option value="@((int)item.Type)">@($"{item.Type}({(int)item.Type})")</option>
                    }
                </optgroup>
                <optgroup label="Download">
                    @foreach (var item in Model.Items.Where(f => GetDownloadTypes().Contains(f.Type)).OrderBy(f => f.Type).ToList())
                    {
                        <option value="@((int)item.Type)">@($"{item.Type}({(int)item.Type})")</option>
                    }
                </optgroup>
                <optgroup label="Delete">
                    @foreach (var item in Model.Items.Where(f => GetDeleteTypes().Contains(f.Type)).OrderBy(f => f.Type).ToList())
                    {
                        <option value="@((int)item.Type)">@($"{item.Type}({(int)item.Type})")</option>
                    }
                </optgroup>
                <optgroup label="Other">
                    @foreach (var item in Model.Items.Where(f => GetOtherTypes().Contains(f.Type)).OrderBy(f => f.Type).ToList())
                    {
                        <option value="@((int)item.Type)">@($"{item.Type}({(int)item.Type})")</option>
                    }
                </optgroup>
            </select>
        </div>

        <div class="create-task-have-to-start-at-container">
            <label for="create-task-have-to-start-at">Start At:</label>
            <input type="datetime-local" id="create-task-have-to-start-at" step="1" required value=""
                   class="click-effect">
        </div>

        <div class="create-task-priority-container">
            <label for="create-task-priority">Priority:</label>
            <input type="range" id="create-task-priority" min="-128" max="127" value="0" list="priority-marks"/>
            <datalist id="priority-marks">
                <option value="-128"></option>
                <option value="0"></option>
                <option value="127"></option>
            </datalist>
        </div>

        <div class="create-task-settings-container">
            <label for="create-task-settings">Settings:</label>
            <textarea id="create-task-settings" spellcheck="false"></textarea>
        </div>

        <button id="create-task-submit-btn" class="btn click-effect" type="submit">Confirm</button>
    </form>
</div>

<div id="scheduled_tasks_partial">
</div>

@section Footer
{
    @await Html.PartialAsync("_MultiSelect", typeOptions, new ViewDataDictionary(ViewData)
    {
        { "id", "task-filter-types" },
        { "default-text", "Types" },
        { "open-up", true }
    })

    @await Html.PartialAsync("_MultiSelect",
        Enum.GetValues<TaskStatus>()
            .OrderBy(f => f)
            .Select(x => new MultiSelectOption { Value = ((int)x).ToString(), Text = $"{x}({(int)x})" }),
        new ViewDataDictionary(ViewData)
        {
            { "id", "task-filter-statuses" },
            { "default-text", "Statuses" },
            { "open-up", true }
        })

    @await Html.PartialAsync("_MultiSelect",
        Enum.GetValues<TaskCron>()
            .OrderBy(f => f)
            .Select(x => new MultiSelectOption { Value = ((int)x).ToString(), Text = $"{x}({(int)x})" })
        , new ViewDataDictionary(ViewData)
        {
            { "id", "task-filter-crons" },
            { "default-text", "Crons" },
            { "open-up", true }
        })
}

@section Scripts
{
    <script nonce="@nonce" src="~/js/libs/axios.min.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/libs/signalr.min.js" referrerpolicy="no-referrer"
            asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/scheduled-task/scheduled-task.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/scheduled-task/scheduled-task-websocket.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/scheduled-task/scheduled-task-filters.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/scheduled-task/scheduled-task-form.js" asp-append-version="true"></script>

    <script nonce="@nonce">
        moveToLinkNav(navElements.ScheduledTasks);

        const taskConfigDefinitions = @Html.Raw(JsonSerializer.Serialize(Model.Items));

        reload();
        setDefaultDateTime();
        updateCreateTaskFromField(typeSelect.value);
    </script>
}
