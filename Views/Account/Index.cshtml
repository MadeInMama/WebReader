@model WebReader.Models.Dtos.AccountDetailsModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
    ViewData["Title"] = "Account";
}

@section SpecialInfo
{
    @if (User.Identity is { IsAuthenticated: true })
    {
        <h3 class="special-info-big">Hello, @User.Identity.Name!</h3>
    }
}

@if (Model.IsTgLinked)
{
    <form method="post" asp-action="Unlink">
        <button class="btn" type="submit">Unlink Telegram</button>
    </form>
}
else
{
    @if (Model.LinkUrl != null)
    {
        <a class="btn" href="@Model.LinkUrl" target="_blank" rel="noopener noreferrer">Click to link</a>
    }
    else
    {
        <form method="post" asp-action="Link">
            <button class="btn" type="submit">Link Telegram</button>
        </form>
    }
}
<br/>
<button id="btn-enable-push" class="btn" style="display:none;">Enable PWA notifications</button>
<button id="btn-disable-push" class="btn" style="display:none;">Disable PWA notifications</button>

@section Scripts
{
    <script nonce="@nonce" src="~/js/libs/axios.min.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/libs/signalr.min.js" referrerpolicy="no-referrer"
            asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/pwa-push.js" asp-append-version="true"></script>
    <script>
        async function setupNotificationButtons() {
            const btnEnable = document.getElementById('btn-enable-push');
            const btnDisable = document.getElementById('btn-disable-push');

            const registration = await navigator.serviceWorker.ready;

            const subscription = await registration.pushManager.getSubscription();

            const isSubscribed = subscription !== null && Notification.permission === 'granted';

            if (btnEnable) {
                if (!isSubscribed) {
                    btnEnable.style.display = 'block';
                    btnEnable.addEventListener('click', async () => {
                        await initPushNotification();
                        btnEnable.style.display = 'none';
                        btnDisable.style.display = 'block';
                    });
                }
            }

            if (btnDisable) {
                if (isSubscribed) {
                    btnDisable.style.display = 'block';
                    btnDisable.addEventListener('click', async () => {
                        await unsubscribeUserFromPush();
                        btnEnable.style.display = 'block';
                        btnDisable.style.display = 'none';
                    });
                }
            }
        }

        setupNotificationButtons();

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/UserTgLinkHub", {
                skipNegotiation: true,                          // Пропускаем этап создания ID сессии
                transport: signalR.HttpTransportType.WebSockets // Работаем ТОЛЬКО через чистые WebSockets
            })
            .build();

        connection.on("UserTgLinkHub", () => {
            window.location.reload();
        })

        connection.start()
            .then(() => {
            })
            .catch(err => console.error(err.toString()));

    </script>
}
