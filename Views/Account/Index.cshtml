@model WebReader.Models.Dtos.AccountDetailsModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
    ViewData["Title"] = "Account";
}

@section Style
{
    <link rel="stylesheet" href="~/css/file-list.css" asp-append-version="true"/>
    <style>
        details > div {
            grid-template-columns: 100%;
            justify-content: flex-start;
            gap: 0.5em;
        }

        details > div > div, details > div > form {
            display: grid;
            grid-template-columns: 11em max-content;
            grid-template-rows: min-content;
            align-items: center;
            justify-content: flex-start;
            gap: 0;
        }
    </style>
}

@section SpecialInfo
{
    @if (User.Identity is { IsAuthenticated: true })
    {
        <h3 class="special-info-big">Hello, @User.Identity.Name!</h3>
    }
}

<details open>
    <summary>
        <span>Notifications and Links</span>
    </summary>

    <div>
        @if (Model.IsTgLinked)
        {
            <form method="post" asp-action="Unlink">
                <label>Telegram:</label>
                <button class="btn" type="submit">Unlink</button>
            </form>
        }
        else
        {
            @if (Model.LinkUrl != null)
            {
                <div>
                    <label>Telegram:</label>
                    <a class="btn" href="@Model.LinkUrl" rel="noopener noreferrer">Click to link</a>
                </div>
            }
            else
            {
                <form method="post" asp-action="Link">
                    <label>Telegram:</label>
                    <button class="btn" type="submit">Link</button>
                </form>
            }
        }
        <div id="btn-enable-push" style="display:none;">
            <label>In-App Notification:</label>
            <button class="btn">Enable PWA notifications</button>
        </div>

        <div id="btn-disable-push" style="display:none;">
            <label>In-App Notification:</label>
            <button class="btn">Disable PWA notifications</button>
        </div>
    </div>
</details>

@section Scripts
{
    <script nonce="@nonce" src="~/js/libs/axios.min.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/libs/signalr.min.js" referrerpolicy="no-referrer"
            asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/pwa-push.js" asp-append-version="true"></script>
    <script>
        //TODO: request for is current device subscribed to PWA notifications
        async function setupNotificationButtons() {
            document.querySelector("#btn-enable-push > button").addEventListener('click', async () => {
                await initPushNotification();
                document.querySelector("#btn-enable-push").style.display = 'none';
                document.querySelector("#btn-disable-push").removeAttribute('style');
            });

            document.querySelector("#btn-disable-push > button").addEventListener('click', async () => {
                await unsubscribeUserFromPush();
                document.querySelector("#btn-enable-push").removeAttribute('style');
                document.querySelector("#btn-disable-push").style.display = 'none';
            });

            const btnEnable = document.getElementById('btn-enable-push');
            const btnDisable = document.getElementById('btn-disable-push');

            const registration = await navigator.serviceWorker.ready;

            const subscription = await registration.pushManager.getSubscription();

            const isSubscribed = subscription !== null && Notification.permission === 'granted';

            if (btnEnable) {
                if (!isSubscribed) {
                    btnEnable.removeAttribute('style');
                }
            }

            if (btnDisable) {
                if (isSubscribed) {
                    btnDisable.removeAttribute('style');
                }
            }
        }

        setupNotificationButtons();

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/UserTgLinkHub", {
                skipNegotiation: true,                          // Пропускаем этап создания ID сессии
                transport: signalR.HttpTransportType.WebSockets // Работаем ТОЛЬКО через чистые WebSockets
            })
            .build();

        connection.on("UserTgLinkHub", () => {
            window.location.reload();
        })

        connection.start()
            .then(() => {
            })
            .catch(err => console.error(err.toString()));

    </script>
}
