@model WebReader.Models.Dtos.AccountDetailsModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
    ViewData["Title"] = "Account";
}

@section Style
{
    <link rel="stylesheet" href="~/css/file-list.css" asp-append-version="true"/>
    <style>
        details > div {
            grid-template-columns: 100%;
            justify-content: flex-start;
            gap: 0.5em;
        }

        details > div > div, details > div > form {
            display: grid;
            grid-template-columns: 11em max-content;
            grid-template-rows: min-content;
            align-items: center;
            justify-content: flex-start;
            gap: 0;
        }

        #in-app-notification-container > label {
            grid-column: 1;
            grid-row: 1;
        }

        #in-app-notification-container > .btn,
        #in-app-notification-container > .event-output {
            grid-column: 2;
            grid-row: 1;
        }

        #in-app-notification-container > .event-output {
            height: 2em;
            width: 2em;
            padding: 0;
        }
    </style>
}

@section SpecialInfo
{
    @if (User.Identity is { IsAuthenticated: true })
    {
        <h3 class="special-info-big">Hello, @User.Identity.Name!</h3>
    }
}

<details open>
    <summary>
        <span>Notifications and Links</span>
    </summary>

    <div>
        @if (Model.IsTgLinked)
        {
            <form method="post" asp-action="Unlink">
                <label>Telegram:</label>
                <button class="btn click-effect" type="submit">Unlink</button>
            </form>
        }
        else
        {
            @if (Model.LinkUrl != null)
            {
                <div>
                    <label>Telegram:</label>
                    <a class="btn click-effect" href="@Model.LinkUrl" rel="noopener noreferrer">Click to link</a>
                </div>
            }
            else
            {
                <form method="post" asp-action="Link">
                    <label>Telegram:</label>
                    <button class="btn" type="submit">Link</button>
                </form>
            }
        }
        <div id="in-app-notification-container">
            <label>In-App Notification:</label>
            <button class="btn click-effect" id="btn-enable-push" style="display:none;">Enable PWA notifications
            </button>
            <button class="btn click-effect" id="btn-disable-push" style="display:none;">Disable PWA notifications
            </button>
            <div class="event-output" id="in-app-notification-waiting">
                <div class="waiting"></div>
            </div>
        </div>
    </div>
</details>

@section Scripts
{
    <script nonce="@nonce" src="~/js/libs/axios.min.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/libs/signalr.min.js" referrerpolicy="no-referrer"
            asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/pwa-push.js" asp-append-version="true"></script>
    <script>
        moveToLinkNav(navElements.Account);

        async function setupNotificationButtons() {
            let isSubscribed = false;

            const endpoint = await isSubscriptionExistsOnLocal();

            if (endpoint) {
                const isExistsOnServer = await isSubscriptionExistsOnServer(endpoint);

                if (!isExistsOnServer) {
                    await unsubscribeUserFromPWANotifications();
                } else {
                    isSubscribed = true;
                }
            }

            document.querySelector("#btn-enable-push").addEventListener('click', async () => {
                document.querySelector("#btn-enable-push").style.display = 'none';
                document.querySelector('#in-app-notification-waiting').removeAttribute('style');

                await subscribeUserToPWANotifications(() => {
                    document.querySelector("#btn-disable-push").removeAttribute('style');
                    document.querySelector('#in-app-notification-waiting').style.display = 'none';
                }, () => {
                    document.querySelector("#btn-enable-push").removeAttribute('style');
                    document.querySelector('#in-app-notification-waiting').style.display = 'none';
                });
            });

            document.querySelector("#btn-disable-push").addEventListener('click', async () => {
                document.querySelector("#btn-disable-push").style.display = 'none';
                document.querySelector('#in-app-notification-waiting').removeAttribute('style');

                await unsubscribeUserFromPWANotifications(() => {
                    document.querySelector("#btn-enable-push").removeAttribute('style');
                    document.querySelector('#in-app-notification-waiting').style.display = 'none';
                }, () => {
                    document.querySelector("#btn-disable-push").removeAttribute('style');
                    document.querySelector('#in-app-notification-waiting').style.display = 'none';
                });
            });

            const btnEnable = document.querySelector('#btn-enable-push');
            const btnDisable = document.querySelector('#btn-disable-push');
            const divWaiting = document.querySelector('#in-app-notification-waiting');

            if (btnEnable) {
                if (!isSubscribed) {
                    divWaiting.style.display = 'none';
                    btnEnable.removeAttribute('style');
                }
            }

            if (btnDisable) {
                if (isSubscribed) {
                    divWaiting.style.display = 'none';
                    btnDisable.removeAttribute('style');
                }
            }
        }

        setupNotificationButtons();

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/UserTgLinkHub", {
                skipNegotiation: true,                          // Пропускаем этап создания ID сессии
                transport: signalR.HttpTransportType.WebSockets // Работаем ТОЛЬКО через чистые WebSockets
            })
            .build();

        connection.on("UserTgLinkHub", () => {
            window.location.reload();
        })

        connection.start()
            .then(() => {
            })
            .catch(err => console.error(err.toString()));

    </script>
}
