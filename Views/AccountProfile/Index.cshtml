@model WebReader.Models.Entities.SubscriberTg?

@{
    ViewData["Title"] = "Profile";
}

<h2>Telegram Account</h2>

@if (Model is { UserId: not null })
{
    <p>Telegram account is linked.</p>
    <form method="post" asp-action="Unlink">
        <button type="submit">Unlink Telegram</button>
    </form>
}
else
{
    <p>No Telegram account linked.</p>

    @if (ViewBag.DeepLinkUrl != null)
    {
        <p>Open this link in Telegram:</p>
        <a href="@ViewBag.DeepLinkUrl">@ViewBag.DeepLinkUrl</a>
    }
    else
    {
        <form method="post" asp-action="Link">
            <button type="submit">Link Telegram</button>
        </form>
    }
}
