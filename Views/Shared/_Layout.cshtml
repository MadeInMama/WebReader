@using WebReader.Models
@inject IHttpContextAccessor HttpContextAccessor
@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <!-- viewport-fit=cover отлично подходит для iPhone с "челкой" / Dynamic Island -->
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover, maximum-scale=1.0"/>

    <!-- Активация режима PWA для Android и iOS (ОБЯЗАТЕЛЬНО) -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <!-- Настройки статус-бара iOS (default, black или black-translucent) -->
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="WebReader">

    <!-- Корректные абсолютные пути без знака тильды ~ -->
    <link rel="apple-touch-icon" href="/images/icon-192.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#000000">

    <title>@ViewData["Title"] - WebReader</title>

    <!-- Использование разрешаемого Razor пути для статики внутри проекта -->
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon"/>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site-items.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/click-effects.css" asp-append-version="true"/>

    @await RenderSectionAsync("Style", false)
</head>
<body>

@Html.AntiForgeryToken()

<div id="safe-area-inset-top"></div>

<header class="can-be-opened opened">
    @await RenderSectionAsync("SpecialInfo", false)
    <nav>
        <ul>
            @if (User.Identity is { IsAuthenticated: true })
            {
                <li>
                    <a asp-controller="Home" asp-action="Index" class="click-effect">Home</a>
                </li>
                <li>
                    <a asp-controller="File" asp-action="GetAllFilesByBucket" class="click-effect">Files</a>
                </li>
            }

            @await RenderSectionAsync("HeaderMenuItems", false)

            @if (User.Identity is { IsAuthenticated: true })
            {
                <li>
                    <a asp-controller="File" asp-action="GetReading" class="click-effect">Reading</a>
                </li>
                @* <li> *@
                @*     <form asp-controller="Account" *@
                @*           asp-action="DeleteMe" *@
                @*           method="post" *@
                @*           style="display:inline;"> *@
                @*         <input type="hidden" name="_method" value="DELETE"/> *@
                @*         <button type="submit" class="click-effect" *@
                @*                 onclick="return confirm('⚠️ This will permanently delete your profile. Continue?');"> *@
                @*             Delete Profile *@
                @*         </button> *@
                @*     </form> *@
                @* </li> *@

                @if (User.GetUserRoles().Contains(RoleType.Admin))
                {
                    <li>
                        <a asp-controller="ScheduledTask" asp-action="ScheduledTasks" class="click-effect">Scheduled
                            Tasks</a>
                    </li>
                }

                <li>
                    <a asp-controller="Account" asp-action="Index" class="click-effect">Account</a>
                </li>
                // TODO: move inside Account
                <li>
                    <a asp-controller="Account" asp-action="Logout" class="click-effect">Logout</a>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Account" asp-action="SignIn" class="click-effect">Sign in</a>
                </li>
                @* <li> *@
                @*     <a asp-controller="Account" asp-action="SignUp" class="click-effect">Sing up</a> *@
                @* </li> *@
            }
        </ul>
    </nav>
    <button class="header-toggle opened-trigger click-effect" target="header"></button>
</header>

<main>
    @RenderBody()
</main>

<footer class="disabled-with-anim">
    @await RenderSectionAsync("Footer", false)
</footer>

<div id="scroll-progress-bar-background"></div>
<div id="scroll-progress-bar"></div>

<div id="safe-area-inset-bottom"></div>

<script nonce="@nonce" src="~/js/cache/cache.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/window-height-setter.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/site.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/custom-event.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/custom-axios.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/custom-fixed-axios.js" asp-append-version="true"></script>
<script nonce="@nonce" src="~/js/to-local-date-time.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
<script nonce="@nonce">
    function registerMyServiceWorker() {
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js')
                .then(_ => {
                    console.log('PWA: Service Worker registered!');
                });

            navigator.serviceWorker.addEventListener('message', function (event) {
                // Проверяем, что пришла именно команда навигации
                if (event.data && event.data.action === 'navigate') {
                    const targetUrl = event.data.url;
                    console.log("PWA: Получена команда навигации из SW на URL:", targetUrl);

                    // Выполняем нативный фронтенд-переход, который на iOS работает идеально
                    window.location.href = targetUrl;
                }
            });
        }
    }

    if (document.readyState === 'complete') {
        registerMyServiceWorker();
    } else {
        window.addEventListener('load', registerMyServiceWorker);
    }

    document.addEventListener('touchstart', () => {
    }, {passive: true});
</script>
</body>
</html>
