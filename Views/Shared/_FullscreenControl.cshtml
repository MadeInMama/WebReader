@{
    var nonce = Context.Items["ScriptNonce"]?.ToString();
}

@if ((bool?)ViewData["render-css-and-js"] ?? false)
{
    <link rel="stylesheet" href="~/css/fullscreen-control.css" asp-append-version="true"/>
}

@switch ((string?)ViewData["do"])
{
    case "enter":
        <button class="fullscreen-btn fullscreen-btn-on disabled-with-anim click-effect" disabled></button>
        break;
    case "exit":
        <button class="fullscreen-btn fullscreen-btn-off disabled-with-anim click-effect" disabled></button>
        break;
}

@if ((bool?)ViewData["render-css-and-js"] ?? false)
{
    <script nonce="@nonce" src="~/js/fullscreen-control-v2.js" asp-append-version="true"></script>
}
