@{
    var nonce = Context.Items["ScriptNonce"]?.ToString();
}

<link rel="stylesheet" href="~/css/audio-controller.css" asp-append-version="true"/>

<div class="audio-controller" disabled>
    <button class="audio-loading-btn" disabled></button>

    <select class="audio-speed-select">
        <option value="0.5">0.5x</option>
        <option value="0.75">0.75x</option>
        <option value="1" selected>1.0x</option>
        <option value="1.25">1.25x</option>
        <option value="1.5">1.5x</option>
        <option value="1.75">1.75x</option>
        <option value="2">2.0x</option>
    </select>

    <input type="range" id="audio-progress-bar" class="audio-progress-bar" disabled value="0" max="100" step="0.1">
    <input type="checkbox" class="audio-auto-next">
</div>


<script nonce="@nonce" src="~/js/audio-controller.js" asp-append-version="true"></script>
