@using WebReader.Models
@model WebReader.Models.Dtos.AllFilesInBucketViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    var nonce = HttpContextAccessor.HttpContext?.Items["ScriptNonce"]?.ToString();
    ViewData["Title"] = "FILES";
}

@section Style {
    <link rel="stylesheet" href="~/css/file-list.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/lazy-image.css" asp-append-version="true"/>
}

@section SpecialInfo {
    @if (User.Identity is { IsAuthenticated: true })
    {
        <h3 class="special-info-big">Hello, @User.Identity.Name!</h3>
    }
}

<div id="full_content">
    <details open class="always-open-details">
        <summary>
            <span style="pointer-events: none">@Model.Items.First().FileName</span>
        </summary>

        <div>
            @foreach (var item in Model.Items)
            {
                <div class="item-line" id="@("RL_" + item.Id)">
                    <div class="lazy-image-wrapper">
                        <img class="lazy-image"
                             src=""
                             data-src="@Url.Action("GetCover", "Cover", new { bucketId = Model.Id, fileId = item.Id })"
                             alt="Book Cover for (@item.CurrentPartNumber) @item.CurrentPartName"
                             loading="lazy"/>
                        <div class="lazy-image-loader"></div>
                    </div>

                    <a asp-controller="File" asp-action="GetFile"
                       asp-route-bucketId="@Model.Id"
                       asp-route-fileId="@item.Id" class="click-effect">
                        <span
                            class="left main-info-span importance-0">@item.CurrentPartName</span>
                        <br/>
                        <span>@item.CurrentPartNumber</span>
                    </a>

                    <div class="event-output">
                        @if (item.IsReading)
                        {
                            <div class="center secondary-info-span @(item.IsDone ? "is-done" : "in-progress")"></div>
                        }
                        <button class="download-file click-effect"
                                data-file-id="@item.Id" data-bucket-id="@Model.Id"
                                data-file-name='@item.FileName (@item.CurrentPartNumber) @item.CurrentPartName'></button>
                        @if (User.GetUserRoles().Contains(RoleType.Admin))
                        {
                            <button class="remove click-effect delete-row-btn"
                                    data-id="@item.Id"
                                    data-name="@item.FileName (@item.CurrentPartNumber) @item.CurrentPartName"></button>
                        }
                    </div>
                </div>
            }
        </div>
    </details>
</div>

@await Html.PartialAsync("_EmptyDisplay")

@if (Model.IsBelongsToUser)
{
    <div class="upload-btn-container">
        <a class="btn click-effect" asp-controller="File"
           asp-action="UploadFile"
           asp-route-bucketId="@Model.Id">
            Upload File
        </a>
    </div>
}

@section Footer {
    <div>
        <label for="asc-direction">Direction:</label>
        <input id="asc-direction" name="ascDirection" type="checkbox" checked="@Model.AscDirection" disabled/>
        <label for="asc-direction" id="asc-direction-visual" class="click-effect"></label>
    </div>

    <div>
        <label for="page-count">Count:</label>
        <select asp-for="PageCount" id="page-count" name="pageCount" class="click-effect" disabled>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="8">8</option>
            <option value="10">10</option>
            <option value="12">12</option>
            <option value="15">15</option>
            <option value="16">16</option>
            <option value="2147483647">MAX</option>
        </select>
    </div>

    <div>
        <label for="page-index">Index:</label>
        <select asp-for="PageIndex" id="page-index" name="pageIndex" class="click-effect" disabled>
            @{
                var maxPageIndex = (int)Math.Ceiling((double)Model.TotalCount / Model.PageCount) - 1;
            }
            @for (var i = 0; i <= maxPageIndex; i++)
            {
                <option value="@i">@(i)/@(maxPageIndex)</option>
            }
        </select>
    </div>

    <div>
        <label for="order-by">Order By:</label>
        <select asp-for="OrderBy" id="order-by" name="orderBy" class="click-effect" disabled>
            @foreach (var item in Model.OrderByValues)
            {
                <option value="@item">@item</option>
            }
        </select>
    </div>
}

@section Scripts {
    <script nonce="@nonce" src="~/js/libs/axios.min.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/cache/file-download.js" asp-append-version="true"></script>
    <script nonce="@nonce">
        moveToLinkNav(navElements.Files);

        const url = '/api/FileApi/DeleteFile';
        const lineSelector = '.item-line';
        const reloadOnDelete = true;

        const ascDirection = document.querySelector("#asc-direction");
        const pageCount = document.querySelector("#page-count");
        const pageIndex = document.querySelector("#page-index");
        const orderBy = document.querySelector("#order-by");

        const allControls = Array.from([ascDirection, pageCount, pageIndex, orderBy]);
        let isControlClickAllowed = false;

        function reloadWithFilter() {
            allControls.forEach(el => el.disabled = true);

            const url = new URL(window.location.href);

            allControls.forEach((control) => {
                const value = control.type === "checkbox" ? control.checked : control.value;

                if (value !== "" && value !== null) {
                    url.searchParams.set(control.name, value);
                } else {
                    url.searchParams.delete(control.name);
                }
            });

            window.location.assign(url.toString());
        }

        function reloadWithFilterAfterDelete(deletedFileId) {
            allControls.forEach(el => el.disabled = true);

            const url = new URL(window.location.href);

            let files = Array.from(document.querySelectorAll("[data-file-id]"));

            if (files.length > 1) {
                let file = files.filter(f => f.dataset.fileId !== deletedFileId);
                url.searchParams.set("fileId", file[0].dataset.fileId);
            } else {
                window.location.assign("/File/GetAllFilesByBucket");
                return;
            }

            allControls.forEach((control) => {
                const value = control.type === "checkbox" ? control.checked : control.value;

                if (value !== "" && value !== null) {
                    url.searchParams.set(control.name, value);
                } else {
                    url.searchParams.delete(control.name);
                }
            });

            window.location.assign(url.toString());
        }

        allControls.forEach(el => {
            el.onchange = () => {
                if (isControlClickAllowed) {
                    isControlClickAllowed = false;
                    reloadWithFilter();
                }
            }
        });
    </script>
    <script nonce="@nonce" src="~/js/empty-row-control.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/delete-row.js" asp-append-version="true"></script>
    <script nonce="@nonce" src="~/js/lazy-image-observer.js" asp-append-version="true"></script>
    <script nonce="@nonce">
        CheckOnEmpty();
        convertUtcToLocal();

        window.addEventListener("load", () => {
            Array.from(document.querySelectorAll(".download-file")).forEach(el => {
                new FileDownloadButton(el, el.dataset.bucketId, el.dataset.fileId, el.dataset.fileName);
            });

            setTimeout(() => {
                isControlClickAllowed = true;
                allControls.forEach(el => el.disabled = false);
            }, 300);
        });
    </script>
}
